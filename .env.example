# ── PostgreSQL ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_secret
POSTGRES_POOL_MIN=10
POSTGRES_POOL_MAX=50

# ── RabbitMQ ───────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=finance_events
RABBITMQ_QUEUE_REWARDS=reward_events
RABBITMQ_PREFETCH_COUNT=100

# ── Redis ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=20

# ── Application ────────────────────────────────
APP_NAME=finance-service
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ── JWT Auth ───────────────────────────────────
JWT_ENABLED=true
JWT_ISSUER=user-service
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=change-me
JWT_LEEWAY_SECONDS=0

# ── Batch Processor ───────────────────────────
BATCH_SIZE=500
BATCH_INTERVAL_SECONDS=5

# ── Inbox Cleanup ──────────────────────────────
INBOX_CLEANUP_DAYS=7
INBOX_CLEANUP_INTERVAL=3600

# ── Outbox Relay ──────────────────────────────
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=200
OUTBOX_CLEANUP_DAYS=7
OUTBOX_CLEANUP_INTERVAL=3600


REST_API_BASE_URL=""
REST_API_TIMEOUT_SECONDS=""
REST_API_MAX_KEEPALIVE_CONNECTIONS=""


USER_MANAGEMENT_ENDPOINT=""
USER_MANAGEMENT_API_KEY= "apikey"
USER_MANAGEMENT_USERS_LOOKUP_PATH= "/api/v0/users/lookup"
USER_MANAGEMENT_TIMEOUT_SECONDS= 10.0